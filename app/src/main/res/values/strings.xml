    <string name="save_folder_prompt_title">Keep your saves in a folder too?</string>
    <string name="save_folder_prompt_body">That way you won\'t lose them if you uninstall the app or change phones, and other emulators can use them too. The folder with your games is the best choice.</string>
    <string name="save_folder_again_title">Get your saves back?</string>
    <string name="save_folder_again_body">You were using a saves folder. Pick it once more and Play Again brings back each save when you open its game.</string>
    <string name="save_folder_choose">Choose folder</string>
    <string name="save_folder_later">Not now</string>
    <string name="save_folder_current">Your saves are also kept in “%1$s”, named after each game.</string>
    <string name="save_folder_change">Change folder</string>
    <string name="save_folder_disable">Stop using it</string>
