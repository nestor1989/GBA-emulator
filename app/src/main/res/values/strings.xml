    <string name="import_guide_title">Import save</string>
    <string name="import_guide_body">Pick the save file from your other emulator. For this game it\'s usually called:\n\n“%1$s.sav” (or .srm if you came from RetroArch)\n\nMy Boy!, VBA and most emulators keep it in the same folder as the game.</string>
    <string name="import_guide_folder">The picker opens in that folder.</string>
    <string name="import_guide_states">Before switching, save inside the game in the other emulator: save states can\'t be imported.</string>
    <string name="import_pick">Choose file</string>
    <string name="import_confirm_file">File: “%1$s”</string>
    <string name="import_name_mismatch">Heads up: the name doesn\'t match the game\'s. If it wasn\'t the right save, you can go back to the previous one from the menu.</string>
    <string name="import_confirm_title">Use this save?</string>
    <string name="import_confirm_body">It replaces the save of %1$s and the game restarts. The current one is kept: you can go back to it from the menu.</string>
    <string name="import_button">Import</string>
    <string name="import_ok">Save imported. The game restarted.</string>
    <string name="import_bad">That file isn\'t a save for this game.</string>
    <string name="import_state">That file looks like a save state from another emulator. Only in-game saves can be imported (.sav, .srm, .gsv, .sps).</string>
    <string name="import_read_error">Couldn\'t read the file.</string>

