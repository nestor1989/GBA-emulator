    <string name="save_folder_error">Couldn\'t use that folder. Try another one.</string>
    <string name="save_folder_restored">Loaded the save from “%1$s”.</string>
    <string name="save_conflict_title">Which save should we use?</string>
    <string name="save_conflict_body">%1$s has two different saves.\n\nIn your folder: saved %2$s\nIn the app: saved %3$s\n\nThe other one isn\'t lost: you can go back to it from the menu with “%4$s”.</string>
